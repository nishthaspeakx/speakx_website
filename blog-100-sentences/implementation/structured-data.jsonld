      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is the 100 daily use English sentences PDF free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The PDF is free, there is no signup or email required, and you can print it or save it on your phone. It has the same 100 sentences and Hindi meanings as the article, plus a 10-day practice tracker."
          }
        },
        {
          "@type": "Question",
          "name": "What are some simple English sentences used at home?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simple English sentences used at home include “I am at home”, “Please come inside”, “The food is ready”, “Did you eat something?” and “I will be back soon”."
          }
        },
        {
          "@type": "Question",
          "name": "How many daily use English sentences should I learn in a day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Five to ten a day is enough if you say them aloud and use one or two in real conversations. Using a sentence matters more than memorising a long list."
          }
        },
        {
          "@type": "Question",
          "name": "Are the Hindi meanings literal translations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Each Hindi meaning is the natural way a Hindi speaker would say the same thing. Where the Hindi verb changes with the speaker, both forms are given."
          }
        },
        {
          "@type": "Question",
          "name": "How can I practise these sentences if no one around me speaks English?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Say each sentence aloud, record and play it back, run imaginary conversations, then find one partner or a speaking app for five minutes a day so you get feedback on how you sound."
          }
        }
      ]
